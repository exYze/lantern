{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lantern",
  "version": "0.6.0",
  "identifier": "dev.lantern.bots",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lantern",
        "width": 1240,
        "height": 820,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: data: blob: https: http:",
        "media-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Open-source AI bots for open-source LLMs",
    "longDescription": "Lantern lets you create AI bots with their own instructions, skills, memories, tools and routines, powered by open-source models you run yourself (Ollama, llama.cpp, vLLM, LM Studio and more).",
    "copyright": "MIT License — Lantern contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "android": {
      "minSdkVersion": 26
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1MDdGNDcyNjQzMkY5RUIKUldUcitUSmtjdlFIeFdHRGxSai9uWkJ0YjJCcXlLbG1GaWFmTXZ0eE1SWGRMWDhrbE9ISDFiMm0K",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
