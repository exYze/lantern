# Lantern Hub settings (/etc/lantern-hub.env). install.sh writes this file for you.
LANTERN_HUB_NAME="Lantern Hub"
LANTERN_HUB_DATA=/var/lib/lantern-hub
# The full API, served to your tailnet over HTTPS by `tailscale serve`.
LANTERN_HUB_LISTEN=unix:/run/lantern-hub/hub.sock
# Downloads page and installers only (no data), for browsers on your network.
LANTERN_HUB_PUBLIC_LISTEN=0.0.0.0:80
LANTERN_HUB_RELEASES=/srv/lantern/releases
LANTERN_HUB_AGENT=unix:/run/lantern-agent/agent.sock
# Shown on the downloads page, e.g. https://lantern.your-tailnet.ts.net
LANTERN_HUB_PUBLIC_URL=
# Your Tailscale login (see `tailscale status --json`, User → LoginName). Devices
# signed in to it pair without a code. Leave empty to always require a code.
LANTERN_HUB_TAILSCALE_OWNER=
