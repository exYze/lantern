[Unit]
Description=Lantern Hub tool runner (bot files and shell commands)
After=network-online.target

[Service]
# A separate, unprivileged user: bot commands can't read the hub's database.
User=lantern-agent
Group=lantern-agent
Environment=SHELL=/bin/bash HOME=/home/lantern-agent
WorkingDirectory=/home/lantern-agent
ExecStart=/usr/local/bin/lantern-hub agent --socket /run/lantern-agent/agent.sock --workspace /home/lantern-agent/workspace
Restart=on-failure
RestartSec=2
RuntimeDirectory=lantern-agent
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
